    "# ==============================================================================\n",
    "# CELL 2: Load and Prepare the Dataset (with Drive cache for fast re-runs)\n",
    "# ==============================================================================\n",
    "from datasets import load_dataset, load_from_disk\n",
    "from transformers import TrOCRProcessor\n",
    "import os\n",
    "\n",
    "# Cached processed dataset paths on Drive\n",
    "TRAIN_CACHE = os.path.join(PROJECT_DIR, 'cache_train_dataset')\n",
    "EVAL_CACHE  = os.path.join(PROJECT_DIR, 'cache_eval_dataset')\n",
    "\n",
    "# Load processor\n",
    "processor = TrOCRProcessor.from_pretrained('microsoft/trocr-small-printed')\n",
    "\n",
    "def preprocess_data(examples):\n",
    "    pixel_values = processor(examples['image'], return_tensors='pt').pixel_values\n",
    "    labels = processor.tokenizer(\n",
    "        examples['formula'],\n",
    "        padding='max_length',\n",
    "        max_length=64,\n",
    "        truncation=True\n",
    "    ).input_ids\n",
    "    labels = [\n",
    "        [tok if tok != processor.tokenizer.pad_token_id else -100 for tok in seq]\n",
    "        for seq in labels\n",
    "    ]\n",
    "    return {'pixel_values': pixel_values.squeeze(), 'labels': labels}\n",
    "\n",
    "# -------------------------------------------------------\n",
    "# FAST RE-RUN: load from Drive cache if already processed\n",
    "# -------------------------------------------------------\n",
    "if os.path.exists(TRAIN_CACHE) and os.path.exists(EVAL_CACHE):\n",
    "    print('⚡ Found cached datasets on Drive — loading instantly (skipping download + preprocessing)...')\n",
    "    train_dataset = load_from_disk(TRAIN_CACHE)\n",
    "    eval_dataset  = load_from_disk(EVAL_CACHE)\n",
    "    print(f'✅ Loaded from cache! Train: {len(train_dataset)}, Eval: {len(eval_dataset)}')\n",
    "\n",
    "else:\n"